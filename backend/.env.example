# ============================================================
# CivicTech — environment template
#
# Copy this file to `.env` and fill in the values from your
# Firebase project. `.env` is gitignored; this file is not.
#
#   Firebase console -> Project settings -> General
#                      -> Your apps -> Web app -> SDK setup
#
# None of these are secrets in the cryptographic sense — Vite
# inlines every VITE_* value into the browser bundle, and Firebase
# ships this exact config to every client on purpose. Your data is
# protected by the security rules in firestore.rules and
# storage.rules, not by hiding these keys. If the app is left
# unconfigured it runs in local demo mode (see FIREBASE_SETUP.md).
# ============================================================

# --- Required -----------------------------------------------
# Identifies the Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Optional -----------------------------------------------
# Only used if you later wire up Firebase Analytics.
VITE_FIREBASE_MEASUREMENT_ID=

# Point the SDK at the local emulator suite instead of production.
# Run `firebase emulators:start` first. Accepts true / false.
VITE_FIREBASE_USE_EMULATORS=false
